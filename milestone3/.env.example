# ===================================================
# SMART IRRIGATION ASSISTANT - BACKEND CONFIGURATION
# ===================================================

# Environment mode: development | production
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite Database URL
DATABASE_URL=sqlite:///./data/irrigation.db

# ===================================================
# SARVAM AI (Dynamic Regional Language & Voice Query)
# ===================================================
# Obtain your API key from https://sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_URL=https://api.sarvam.ai

# ===================================================
# WEB PUSH NOTIFICATIONS (VAPID Keys)
# ===================================================
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BExamplePublicKey_ReplaceWithYourGeneratedVapidPublicKeyHere
VAPID_PRIVATE_KEY=ExamplePrivateKey_ReplaceWithYourGeneratedVapidPrivateKeyHere
VAPID_CLAIMS_SUB=mailto:admin@smartirrigation.local

# ===================================================
# TWILIO SMS (Alerts & Reminders)
# ===================================================
# Leave blank or demo to run in simulated mode
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ===================================================
# SENDGRID EMAIL (Alerts & Reports)
# ===================================================
# Leave blank or demo to run in simulated mode
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=alerts@smartirrigation.local
